	local baseX, baseY = 44, 144

	if opts.scroll then
		local scrollH = 254
		outline(g, 44, 144, 462, scrollH, DIM)
		box(g, 44, 144, 462, 14, DIM, 0.4)
		label(g, "// SCROLL FOR MORE", 50, 145, 160, 12, 9, MID, LEFT)

		scrollFrame = Instance.new("ScrollingFrame")
		scrollFrame.BackgroundTransparency = 1
		scrollFrame.BorderSizePixel = 0
		scrollFrame.Position = UDim2.fromOffset(45, 158)
		scrollFrame.Size = UDim2.fromOffset(460, scrollH - 14)
		scrollFrame.CanvasSize = UDim2.fromOffset(0, 0)
		scrollFrame.ScrollBarThickness = 4
		scrollFrame.ScrollBarImageColor3 = MID
		scrollFrame.ScrollingDirection = Enum.ScrollingDirection.Y
		scrollFrame.ClipsDescendants = true
		scrollFrame.Parent = g
		container = scrollFrame
		baseX, baseY = 6, 8
	end

	local groups = {}
	local y = baseY
	local BH, PITCH = 34, 40
	for _, sec in ipairs(sections) do
		label(container, "// " .. sec.title, baseX, y, 300, 12, 9, MID, LEFT)
		y += 18
		local cols = sec.cols or 2
		local areaW = (opts.scroll and 436 or 462)
		local bw = (areaW - (cols - 1) * 10) / cols
		for n, it in ipairs(sec.items) do
			local col = (n - 1) % cols
			local row = math.floor((n - 1) / cols)
			local ob
			ob = newButton(container, {
				text = it.text, kind = it.kind or "action", on = it.on, color = it.color,
				x = baseX + col * (bw + 10), y = y + row * PITCH, w = bw, h = BH,
				onClick = function(self)
					if it.group then
						for _, other in ipairs(groups[it.group]) do
							other.setOn(other == self)
						end
					elseif it.kind == "toggle" then
						self.setOn(not self.on)
					end
					if it.cb then it.cb(self.on) end
				end,
			})
			if it.group then
				groups[it.group] = groups[it.group] or {}
				table.insert(groups[it.group], ob)
			end
			table.insert(page.buttons, ob)
		end
		y += math.ceil(#sec.items / cols) * PITCH + 4
	end

	if opts.scroll then
		scrollFrame.CanvasSize = UDim2.fromOffset(0, y + 8)
	end

	if infoFn then
		outline(g, 44, 398, 462, 86, DIM)
		box(g, 44, 398, 462, 14, DIM, 0.4)
		label(g, "// LIVE DATA", 50, 399, 150, 12, 9, LIGHT, LEFT)
		local infoLbl = label(g, "", 52, 416, 446, 66, 11, LIGHT, LEFT)
		infoLbl.TextYAlignment = Enum.TextYAlignment.Top
		page.info = function() infoLbl.Text = infoFn() end
	end
	return page
end

