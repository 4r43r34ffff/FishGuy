	okBtn.MouseLeave:Connect(function()
		tween(okFill, 0.25, { Size = UDim2.fromOffset(0, 34) })
		tween(okLabel, 0.2, { TextColor3 = LIGHT })
	end)

	okBtn.Activated:Connect(function()
		copyToClipboard(YT_LINK)
		scramble(copiedTag, "COPIED", 0.2)
		task.delay(0.05, function()
			tween(dim, 0.25, { BackgroundTransparency = 1 })
			local tw = tween(card, 0.25, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tw.Completed:Wait()
			promptGui:Destroy()
			if onDone then onDone() end
		end)
	end)

	tween(card, 0.35, { Size = UDim2.fromOffset(CARD_W, CARD_H) }, Enum.EasingStyle.Back)
end

