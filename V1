local function box(parent, x, y, w, h, color, transparency)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color or LIGHT
	f.BackgroundTransparency = transparency or 0
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.Parent = parent
	return f
end

local function outline(parent, x, y, w, h, color, thickness)
	local f = box(parent, x, y, w, h, color, 1)
	local s = Instance.new("UIStroke")
	s.Color = color or MID
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	return f, s
end

local function circle(parent, cx, cy, r, color, thickness, transparency)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(cx, cy)
	f.Size = UDim2.fromOffset(r * 2, r * 2)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = color or LIGHT
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.Parent = f
	return f, s
end

local function label(parent, text, x, y, w, h, size, color, align, font)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromOffset(x, y)
	t.Size = UDim2.fromOffset(w, h)
	t.Text = text
	t.TextSize = size or 12
	t.TextColor3 = color or LIGHT
	t.Font = font or FONT_SMALL
	t.TextXAlignment = align or LEFT
	t.Parent = parent
	return t
end

local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function tweenWait(obj, time, props, style, dir)
	local tw = tween(obj, time, props, style, dir)
	tw.Completed:Wait()
end

-- text "decode" effect
local SCR = "01#%$@&*<>/=+"
local scrambleTokens = setmetatable({}, { __mode = "k" })
local function scramble(lbl, final, dur)
	local token = {}
	scrambleTokens[lbl] = token
	task.spawn(function()
		local steps = math.max(1, math.floor(dur / 0.03))
		for s = 1, steps do
			if scrambleTokens[lbl] ~= token then return end
			local resolved = math.floor(#final * s / steps)
			local out = {}
			for c = 1, #final do
				if c <= resolved or string.sub(final, c, c) == " " then
					out[c] = string.sub(final, c, c)
				else
					local k = rnd:NextInteger(1, #SCR)
					out[c] = string.sub(SCR, k, k)
				end
			end
			lbl.Text = table.concat(out)
			task.wait(0.03)
		end
		if scrambleTokens[lbl] == token then lbl.Text = final end
	end)
end

-- console log queue
local logQueue = {}
local function log(msg)
	table.insert(logQueue, "> " .. msg)
	while #logQueue > 6 do table.remove(logQueue, 1) end
end

local function getPing()
