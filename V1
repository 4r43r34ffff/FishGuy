----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local smoothN = Vector2.zero
local dragVel = Vector2.zero
local lastCenter
local retPos = Vector2.new(0, 0)
local wasRet = false
local sweepAng = 0
local fpsAcc, fpsFrames = 0, 0
local tickAcc, infoAcc = 0, 0
local lastClock = ""
local mouseWin = Vector2.zero

RunService.RenderStepped:Connect(function(dt)
	t += dt
	local mouse = UserInputService:GetMouseLocation()

	-- bubble drag (mouse): polled every frame so it can't glitch/desync,
	-- same technique as the main window drag below. Runs even while the
	-- window itself is hidden (i.e. while minimized).
	if bubbleDragging and not bubbleIsTouch then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			local c = clampToScreen(mouse + bubbleDragOffset, BUB / 2, BUB / 2)
			bubble.Position = UDim2.fromOffset(c.X, c.Y)
			if (mouse - bubbleMouseStart).Magnitude > 4 then bubbleMoved = true end
		else
			bubbleDragging = false
		end
	end

	if inner.Visible then
		local size = inner.AbsoluteSize

		-- drag (mouse): follow the live cursor every frame
		local dragCenter
		if dragging and not dragIsTouch then
			if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				dragCenter = clampCenter(mouse + dragOffset)
				window.Position = UDim2.fromOffset(dragCenter.X, dragCenter.Y)
			else
				dragging = false
			end
		end

		local center = dragCenter or (inner.AbsolutePosition + size / 2)
		local origin = center - size / 2
		mouseWin = mouse - origin

		----------------------------------------------------- parallax
		if lastCenter then
			local v = (center - lastCenter) / math.max(dt, 1 / 240)
			dragVel = dragVel:Lerp(v, 1 - math.exp(-dt * 12))
		end
		lastCenter = center
		local dN = Vector2.new(math.clamp(dragVel.X / 900, -1, 1), math.clamp(dragVel.Y / 900, -1, 1))

		kick = kick * math.exp(-dt * 5)
		local target = Vector2.zero
		if CFG.parallax then
			-- while actively dragging, ignore the raw mouse-to-center offset (it stays
			-- roughly constant for the whole drag and was causing a stuck skew) and
			-- rely only on drag velocity for a subtle motion feel
			local raw = dragging and Vector2.zero or (mouse - center) / 360
			target = Vector2.new(
				math.clamp(raw.X + dN.X * 0.9 + kick.X, -1.3, 1.3),
				math.clamp(raw.Y + dN.Y * 0.9 + kick.Y, -1.3, 1.3)
			)
		end
		smoothN = smoothN:Lerp(target, 1 - math.exp(-dt * 7))

		local prox = math.clamp(1 - smoothN.Magnitude, 0, 1)
		for _, L in ipairs(layers) do
			local o = smoothN * (-L.shift * CFG.parMul)
			if L.glitchy then o += glitchOff end
			L.frame.Position = UDim2.fromOffset(WIN_W / 2 + o.X, WIN_H / 2 + o.Y)
			L.scale.Scale = 1 + L.zoom * prox * CFG.parMul
		end

		----------------------------------------------------- background
		stripeHolder.Position = UDim2.fromOffset((t * 10) % 70, 0)
		sweepBar.Position = UDim2.fromOffset(0, ((t * 0.28) % 1) * (WIN_H + 70) - 70)

		----------------------------------------------------- grid reacts to cursor (anywhere on screen)
		local gp = gridLayer.Position
		local gx = mouseWin.X - (gp.X.Offset - WIN_W / 2)
		local gy = mouseWin.Y - (gp.Y.Offset - WIN_H / 2)
		for _, p in ipairs(plusList) do
			local dx, dy = p.x - gx, p.y - gy
			local k = math.clamp(1 - math.sqrt(dx * dx + dy * dy) / 100, 0, 1)
			k = k * k
			p.l.TextColor3 = DIM:Lerp(ACC.color, k)
			p.l.TextSize = 14 + 10 * k
			p.l.Rotation = k * 45
		end

		----------------------------------------------------- home page (updates panel)
		if pages[1].group.Visible then
			recDot.BackgroundTransparency = (math.sin(t * 4) > 0) and 0 or 0.85
		end

		----------------------------------------------------- gauges
		for _, g in ipairs(gauges) do
			local level = 0.55 + 0.33 * math.sin(t * 0.9 + g.phase) + 0.08 * math.sin(t * 3.1 + g.phase * 2)
			level = math.clamp(level, 0, 1)
			local n = math.floor(level * 16 + 0.5)
			if n ~= g.last then
				g.last = n
				for i = 1, 16 do
					local fromBottom = 17 - i
					local seg = g.segs[i]
					if fromBottom <= n then
						seg.BackgroundColor3 = (fromBottom == n) and ACC.color or LIGHT
						seg.BackgroundTransparency = 0
					else
						seg.BackgroundColor3 = DIM
						seg.BackgroundTransparency = 0.4
					end
				end
				g.pct.Text = math.floor(level * 100) .. "%"
			end
		end
		blinkL.BackgroundTransparency = (math.sin(t * 5) > 0) and 0 or 0.8
		blinkR.BackgroundTransparency = (math.sin(t * 3 + 1) > 0) and 0 or 0.8
		onlineTag.TextTransparency = (math.sin(t * 4) > -0.3) and 0 or 0.7
		barDash.BackgroundTransparency = (math.sin(t * 6) > 0) and 0 or 0.6

		----------------------------------------------------- progress / clock / ticks
		local prog = (t * 0.12) % 1
		progFill.Size = UDim2.fromOffset(188 * prog, 6)
		progLabel.Text = string.format("%02d/06", math.floor(prog * 6) + 1)

		local c = os.date("%I:%M:%S %p   %m/%d/%Y")
		if c ~= lastClock then lastClock = c; clockLabel.Text = c end

		tickAcc += dt
		if tickAcc > 0.12 then
			tickAcc = 0
			for _, s in ipairs(tickSquares) do
				local r = rnd:NextNumber()
				s.BackgroundColor3 = r < 0.15 and ACC.color or (r < 0.5 and WHITE or MID)
			end
		end

		dot.BackgroundColor3 = dragging and ACC.color or BG
		panelStroke.Color = dragging and ACC.color or DIM

		fpsAcc += dt
		fpsFrames += 1
		if fpsAcc >= 0.5 then
			fpsValue = math.floor(fpsFrames / fpsAcc + 0.5)
			fpsLabel.Text = string.format("FPS %03d", fpsValue)
			fpsAcc, fpsFrames = 0, 0
		end

		----------------------------------------------------- live data card
		infoAcc += dt
		if infoAcc > 0.2 then
			infoAcc = 0
			local pg = pages[currentPage]
			if pg and pg.info then pg.info() end
		end
	end

	----------------------------------------------------------- reticle (always, anywhere on screen)
	local showRet = CFG.reticle and window.Visible
	reticle.Visible = showRet
	setCursorHidden(showRet)
	if showRet then
		if not wasRet then retPos = mouse end
		retPos = retPos:Lerp(mouse, 1 - math.exp(-dt * 35))
		reticle.Position = UDim2.fromOffset(retPos.X, retPos.Y)
		spin.Rotation = (t * 70) % 360

		local hover = next(hovered) ~= nil
		local pressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		local goal = pressed and 0.7 or (hover and 1.3 or 1)
		retScale.Scale = retScale.Scale + (goal - retScale.Scale) * math.min(1, dt * 18)

		local locked = false
		local hot = hover or locked
		retStroke.Color = hot and WHITE or ACC.color
		retText.TextColor3 = hot and WHITE or ACC.color
		retText.Text = string.format("%s %04d,%04d", hover and "SELECT" or (locked and "LOCK" or "POS"), mouse.X, mouse.Y)
	end
	wasRet = showRet
end)

