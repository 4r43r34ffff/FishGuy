local setMinimized -- forward declaration; defined below, used by the handlers above

-- bubble dragging (also handles single-click to restore)
-- Mouse uses the same per-frame polling as the main window drag (see the
-- RenderStepped loop below) so it can't desync/glitch; touch uses delta-based
-- movement since touch input doesn't support GetMouseLocation-style polling.
local bubbleDragging, bubbleIsTouch, bubbleMoved = false, false, false
local bubbleDragOffset = Vector2.zero
local bubbleMouseStart = Vector2.zero
local bubbleTouchStart, bubbleTouchStartCenter

bubble.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		bubbleDragging, bubbleIsTouch, bubbleMoved = true, false, false
		local mouse = UserInputService:GetMouseLocation()
		bubbleMouseStart = mouse
		bubbleDragOffset = (bubble.AbsolutePosition + bubble.AbsoluteSize / 2) - mouse
		tween(bubble, 0.12, { Size = UDim2.fromOffset(BUB * 0.9, BUB * 0.9) })
	elseif input.UserInputType == Enum.UserInputType.Touch then
		bubbleDragging, bubbleIsTouch, bubbleMoved = true, true, false
		bubbleTouchStart = input.Position
		bubbleTouchStartCenter = Vector2.new(bubble.Position.X.Offset, bubble.Position.Y.Offset)
		tween(bubble, 0.12, { Size = UDim2.fromOffset(BUB * 0.9, BUB * 0.9) })
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				bubbleDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if bubbleDragging and bubbleIsTouch and input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - bubbleTouchStart
		local c = clampToScreen(bubbleTouchStartCenter + Vector2.new(d.X, d.Y), BUB / 2, BUB / 2)
		bubble.Position = UDim2.fromOffset(c.X, c.Y)
		if d.Magnitude > 4 then bubbleMoved = true end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if bubbleDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		bubbleDragging = false
		tween(bubble, 0.2, { Size = UDim2.fromOffset(BUB, BUB) }, Enum.EasingStyle.Back)
		if not bubbleMoved then
			task.spawn(setMinimized, false)
		end
	end
end)

function setMinimized(v)
	if busy or minimized == v then return end
	minimized = v
	busy = true
	if v then
		local center = window.AbsolutePosition + window.AbsoluteSize / 2
		bubble.Position = UDim2.fromOffset(center.X, center.Y)
		bubble.Size = UDim2.fromOffset(0, 0)
