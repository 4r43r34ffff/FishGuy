local function glitchSequence()
	local base, chars = "FishGuy", "01#%$@&*<>/"
	for _ = 1, rnd:NextInteger(5, 10) do
		local out = {}
		for c = 1, #base do
			if rnd:NextNumber() < 0.35 then
				local k = rnd:NextInteger(1, #chars)
				out[c] = string.sub(chars, k, k)
			else
				out[c] = string.sub(base, c, c)
			end
		end
		local s = table.concat(out)
		title.Text, ghostA.Text, ghostB.Text = s, s, s
		ghostA.TextTransparency, ghostB.TextTransparency = 0.35, 0.35
		ghostA.Position = UDim2.fromOffset(TITLE_X + rnd:NextInteger(-6, 6), TITLE_Y + rnd:NextInteger(-2, 2))
		ghostB.Position = UDim2.fromOffset(TITLE_X + rnd:NextInteger(-6, 6), TITLE_Y + rnd:NextInteger(-2, 2))
		glitchOff = Vector2.new(rnd:NextInteger(-6, 6), rnd:NextInteger(-3, 3))
		task.wait(0.045)
	end
	title.Text, ghostA.Text, ghostB.Text = base, base, base
	ghostA.TextTransparency, ghostB.TextTransparency = 1, 1
	glitchOff = Vector2.zero
end

