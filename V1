----------------------------------------------------------------
-- Accent color system (theme tab recolors everything registered)
----------------------------------------------------------------
local ACC = { color = GREEN, name = "EMERALD", token = nil }
local accented, accentFns = {}, {}

local function reg(inst, prop)
	table.insert(accented, { inst = inst, prop = prop or "BackgroundColor3" })
	return inst
end

local function applyAccent(c)
	ACC.color = c
	for _, r in ipairs(accented) do
		r.inst[r.prop] = c
	end
	for _, fn in ipairs(accentFns) do
		fn(c)
	end
end

local function setAccent(new)
	local old = ACC.color
	local token = {}
	ACC.token = token
	task.spawn(function()
		for i = 1, 16 do
			if ACC.token ~= token then return end
			applyAccent(old:Lerp(new, i / 16))
			task.wait(0.02)
		end
	end)
end

