local layers = {}
local function newLayer(name, z, shift, zoom, extra, glitchy)
	extra = extra or 0
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(WIN_W / 2, WIN_H / 2)
	f.Size = UDim2.fromOffset(WIN_W + extra, WIN_H + extra)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Parent = inner
	local sc = Instance.new("UIScale")
	sc.Parent = f
	table.insert(layers, { frame = f, shift = shift, zoom = zoom or 0, scale = sc, glitchy = glitchy })
	return f
end

