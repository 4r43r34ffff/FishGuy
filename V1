-- Page switching
----------------------------------------------------------------
local function showPage(i, instant)
	if i == currentPage and not instant then return end
	currentPage = i
	pageGen += 1
	local gen = pageGen

	for k, tobj in ipairs(tabObjs) do
		tobj.setActive(k == i, instant)
	end
	tween(tabIndicator, instant and 0 or 0.45,
		{ Position = UDim2.fromOffset(TAB_X0 + (i - 1) * (TAB_W + TAB_GAP), TAB_Y + TAB_H) },
		Enum.EasingStyle.Back)
	scramble(pageTag, string.format("[ %02d/05 ]", i), 0.4)

	for k, pg in ipairs(pages) do
		if k ~= i and pg.group.Visible then
			for _, bo in ipairs(pg.buttons) do bo.unhover() end
			tween(pg.group, 0.18, { GroupTransparency = 1 })
			task.delay(0.2, function()
				if currentPage ~= k then pg.group.Visible = false end
			end)
		end
	end

	local pg = pages[i]
	pg.group.Visible = true
	if instant then
		pg.group.GroupTransparency = 0
		pg.group.Position = UDim2.fromOffset(0, 0)
		for _, bo in ipairs(pg.buttons) do bo.frame.Visible = true end
	else
		pg.group.GroupTransparency = 1
		pg.group.Position = UDim2.fromOffset(0, 12)
		tween(pg.group, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
		for n, bo in ipairs(pg.buttons) do
			bo.frame.Visible = false
			task.delay(0.05 + n * 0.045, function()
				if gen ~= pageGen then return end
				bo.frame.Position = UDim2.fromOffset(bo.base.X - 28, bo.base.Y)
				bo.frame.Visible = true
				tween(bo.frame, 0.4, { Position = UDim2.fromOffset(bo.base.X, bo.base.Y) }, Enum.EasingStyle.Back)
			end)
		end
		pageWipe.Position = UDim2.fromOffset(44, 108)
		pageWipe.BackgroundTransparency = 0.15
		tween(pageWipe, 0.5, { Position = UDim2.fromOffset(44, 488), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		kick = Vector2.new((rnd:NextNumber() < 0.5 and -1 or 1) * 0.5, 0)
		log("PAGE -> " .. pageOrder[i])
	end
end

