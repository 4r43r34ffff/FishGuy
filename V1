local function newButton(parent, o)
	local obj = { on = o.on or false, hover = false, kind = o.kind or "action" }
	local w, h = o.w, o.h

	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Text = ""
	b.BackgroundColor3 = BTN_BG
	b.BorderSizePixel = 0
	b.Position = UDim2.fromOffset(o.x, o.y)
	b.Size = UDim2.fromOffset(w, h)
	b.ClipsDescendants = true
	b.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color = MID
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local sc = Instance.new("UIScale")
	sc.Parent = b

	local fill = box(b, 0, 0, 0, h, WHITE, 0.9)
	local bar = box(b, 0, 0, 3, h, MID)
	local txt = label(b, o.text, 14, 0, w - 38, h, 12, LIGHT, LEFT, FONT_SMALL)
	txt.TextTruncate = Enum.TextTruncate.AtEnd
	local ind = box(b, w - 20, h / 2 - 4, 8, 8, DIM)
	local st
	if obj.kind == "toggle" then
		st = label(b, "OFF", w - 66, 0, 40, h, 9, MID, RIGHT)
	end

	local function paint(skipStroke)
		local hot = obj.on or obj.hover
		local c = hot and ACC.color or MID
		if not skipStroke then
			stroke.Color = c
			bar.BackgroundColor3 = c
		end
		if obj.kind == "swatch" then
			ind.BackgroundColor3 = o.color
		elseif obj.kind == "action" then
			ind.BackgroundColor3 = obj.hover and ACC.color or DIM
		else
			ind.BackgroundColor3 = obj.on and ACC.color or DIM
		end
		if st then
			st.Text = obj.on and "ON" or "OFF"
			st.TextColor3 = obj.on and ACC.color or MID
		end
	end
	table.insert(accentFns, function() paint() end)
	paint()

	function obj.setOn(v)
		obj.on = v
		paint()
	end

	b.MouseEnter:Connect(function()
		obj.hover = true
		hovered[obj] = true
		tween(fill, 0.3, { Size = UDim2.fromOffset(w, h) })
		tween(stroke, 0.15, { Color = ACC.color })
		tween(bar, 0.2, { Size = UDim2.fromOffset(6, h), BackgroundColor3 = ACC.color })
		tween(txt, 0.2, { Position = UDim2.fromOffset(20, 0) })
		paint(true)
		scramble(txt, o.text, 0.18)
	end)

	local function unhover()
		obj.hover = false
		hovered[obj] = nil
		tween(fill, 0.25, { Size = UDim2.fromOffset(0, h) })
		tween(bar, 0.2, { Size = UDim2.fromOffset(3, h), BackgroundColor3 = obj.on and ACC.color or MID })
		tween(stroke, 0.2, { Color = obj.on and ACC.color or MID })
		tween(txt, 0.2, { Position = UDim2.fromOffset(14, 0) })
		tween(sc, 0.15, { Scale = 1 })
		paint(true)
	end
	b.MouseLeave:Connect(unhover)

	b.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = 0.95 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	b.Activated:Connect(function()
		local fl = box(b, 0, 0, w, h, WHITE, 0.55)
		tween(fl, 0.35, { BackgroundTransparency = 1 })
		task.delay(0.36, function() fl:Destroy() end)

		local p = UserInputService:GetMouseLocation() - b.AbsolutePosition
		local r, s = circle(b, p.X, p.Y, 2, ACC.color, 2, 0.1)
		tween(r, 0.5, { Size = UDim2.fromOffset(w * 1.6, w * 1.6) })
		tween(s, 0.5, { Transparency = 1 })
		task.delay(0.55, function() r:Destroy() end)

		scramble(txt, o.text, 0.25)
		if o.onClick then o.onClick(obj) end
	end)

	obj.frame = b
	obj.base = Vector2.new(o.x, o.y)
	obj.unhover = unhover
	return obj
end

