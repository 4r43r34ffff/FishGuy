----------------------------------------------------------------
-- Dragging (uses the live mouse position every frame = no glitching)
----------------------------------------------------------------
local dragOffset = Vector2.zero
local dragIsTouch = false
local touchStart, touchStartCenter

local function clampCenter(c)
	local vp = gui.AbsoluteSize
	local hx, hy = WIN_W / 2, WIN_H / 2
	return Vector2.new(
		math.max(hx, math.min(vp.X - hx, c.X)),
		math.max(hy, math.min(vp.Y - hy, c.Y))
	)
end

topBar.InputBegan:Connect(function(input)
	if not ready then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragIsTouch = false
		dragOffset = (window.AbsolutePosition + window.AbsoluteSize / 2) - UserInputService:GetMouseLocation()
	elseif input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragIsTouch = true
		touchStart = input.Position
		touchStartCenter = window.AbsolutePosition + window.AbsoluteSize / 2
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

